{
    "name": "inertiaui-modal",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.13.1",
    "scripts": {
        "dev:vue": "pnpm --filter @inertiaui/modal-vue dev",
        "dev:react": "pnpm --filter @inertiaui/modal-react dev",
        "dev:demo": "pnpm --filter demo-app dev",
        "build": "pnpm --filter @inertiaui/modal-vue build && pnpm --filter @inertiaui/modal-react build",
        "test": "pnpm --filter @inertiaui/modal-vue test --run && pnpm --filter @inertiaui/modal-react test --run",
        "lint": "pnpm --filter @inertiaui/modal-vue eslint && pnpm --filter @inertiaui/modal-react eslint",
        "format": "pnpm --filter @inertiaui/modal-vue prettier && pnpm --filter @inertiaui/modal-react prettier"
    },
    "devDependencies": {
        "@heroicons/react": "^2.1.4",
        "@inertiajs/core": "^3.3.0",
        "@inertiajs/react": "^3.3.0",
        "@inertiajs/vue3": "^3.3.0",
        "@inertiaui/vanilla": "^1.0.2",
        "@testing-library/react": "^16.0.0",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "@vitejs/plugin-react": "^6.0.0",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/coverage-v8": "^4.1.8",
        "@vitest/ui": "^4.1.8",
        "@vue/test-utils": "^2.4.6",
        "clsx": "^2.1.1",
        "eslint": "^10.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "happy-dom": "^20.10.1",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.2.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^5.0.2",
        "vitest": "^4.1.8",
        "vue": "^3.5.x",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.3"
    }
}
