{
    "name": "inertiaui-modal",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.13.1",
    "scripts": {
        "dev:vue": "pnpm --filter @inertiaui/modal-vue dev",
        "dev:react": "pnpm --filter @inertiaui/modal-react dev",
        "dev:demo": "pnpm --filter demo-app dev",
        "build": "pnpm --filter @inertiaui/modal-vue build && pnpm --filter @inertiaui/modal-react build",
        "test": "pnpm --filter @inertiaui/modal-vue test --run && pnpm --filter @inertiaui/modal-react test --run",
        "lint": "oxlint --fix",
        "format": "oxfmt"
    },
    "devDependencies": {
        "@heroicons/react": "^2.1.4",
        "@inertiajs/core": "^3.0.0",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@inertiaui/vanilla": "^1.0.2",
        "@testing-library/react": "^16.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.0",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/coverage-v8": "^4.0.0",
        "@vitest/ui": "^4.0.0",
        "@vue/test-utils": "^2.4.6",
        "clsx": "^2.1.1",
        "happy-dom": "^20.0.0",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "laravel-vite-plugin": "^3.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.0",
        "vite": "^8.0.0",
        "vite-plugin-dts": "^5.0.0",
        "vitest": "^4.0.0",
        "vue": "^3.4.x",
        "vue-tsc": "^2.2.0"
    }
}
