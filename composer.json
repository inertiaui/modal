{
    "name": "inertiaui/modal",
    "description": "Inertia Modal",
    "homepage": "https://github.com/inertiaui/modal",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.11||^12.0||^13.0",
        "inertiajs/inertia-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.9",
        "laravel/dusk": "^8.3",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^9.1||^10.0||^11.0",
        "rector/rector": "^1.0.3||^2.3"
    },
    "conflict": {
        "friendsofphp/php-cs-fixer": "<3.74.0"
    },
    "autoload": {
        "psr-4": {
            "InertiaUI\\Modal\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector",
        "eslint-react": "pnpm --filter @inertiaui/modal-react run eslint",
        "eslint-vue": "pnpm --filter @inertiaui/modal-vue run eslint",
        "build-react": "pnpm --filter @inertiaui/modal-react run build",
        "build-vue": "pnpm --filter @inertiaui/modal-vue run build",
        "all": [
            "@analyse",
            "@refactor",
            "@format",
            "@eslint-react",
            "@eslint-vue"
        ],
        "build": [
            "@all",
            "@build-react",
            "@build-vue"
        ],
        "version": [
            "pnpm --filter @inertiaui/modal-react version ${VERSION}",
            "@build-react",
            "pnpm --filter @inertiaui/modal-vue version ${VERSION}",
            "@build-vue"
        ],
        "update-all": [
            "composer update",
            "pnpm update -r",
            "cd demo-app && composer update"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InertiaUI\\Modal\\ModalServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}